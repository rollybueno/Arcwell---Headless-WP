WP_GRAPHQL_URL=http://localhost:10048/arcwell/graphql
FRONTEND_URL=http://localhost:3000
# Match the identity and keys saved under WordPress Settings → Arcwell.
ARCWELL_SOURCE_ID=
ARCWELL_PREVIEW_SECRET=
ARCWELL_WEBHOOK_SECRET=
# Dedicated editorial account: authenticated previews only (server-side).
WP_PREVIEW_USERNAME=
WP_PREVIEW_APP_PASSWORD=
# Durable local directory for webhook acknowledgments; use a shared store for multi-instance deployments.
ARCWELL_DELIVERY_DIR=.arcwell-deliveries
