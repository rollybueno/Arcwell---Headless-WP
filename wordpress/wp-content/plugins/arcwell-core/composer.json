{
  "name": "arcwell/arcwell-core",
  "description": "Arcwell WordPress editorial and publishing integration",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "autoload": {
    "psr-4": {
      "Arcwell\\Core\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.13",
    "php-stubs/wordpress-stubs": "^6.8 || ^6.9 || ^7.0 || ^7.1"
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=1536M",
    "lint": "phpcs"
  }
}
